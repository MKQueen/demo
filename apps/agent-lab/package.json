{
  "name": "mini-opencode",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "手搓一个 mini 版 opencode（CLI + 网页可视化面板）：用 Node 24 原生 TypeScript 从零实现一个 AI 编码 Agent（零运行时依赖）",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "chat": "node src/main.ts chat",
    "run": "node src/main.ts run",
    "mock": "node src/main.ts chat --mock",
    "sessions": "node src/main.ts sessions",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "example:01": "node examples/01-hello-llm.ts",
    "example:02": "node examples/02-one-tool.ts",
    "example:03": "node examples/03-mini-agent.ts",
    "build": "node scripts/build-dist.mjs",
    "record": "node scripts/record-fixtures.mjs",
    "web": "node src/main.ts web",
    "code-map": "node scripts/code-map.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
