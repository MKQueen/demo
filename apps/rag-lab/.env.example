# 复制成 .env 再填 key：cp .env.example .env
# 本项目兼容任何 OpenAI 风格的 /chat/completions 接口（DeepSeek / OpenAI / 硅基流动 / Ollama 都行）
#
# 生成只走真实大模型：没有可用 Key 时页面会明确显示「未连接真实模型」，
# 不会再有离线抽取式答案 / 录制回放之类的假回答。
# 也可以直接复用 apps/agent-lab/.env 里的配置（把下面几项抄过来即可）。

# 必填：API Key（服务器模式与浏览器模式都靠它调用真实大模型）
DEEPSEEK_API_KEY=sk-在这里填你的key

# 可选：模型服务地址（默认官方 DeepSeek）
OPENAI_BASE_URL=https://api.deepseek.com

# 可选：模型名（baseUrl 和模型名必须属于同一家服务商）
RAG_MODEL=deepseek-flash

# 可选：端口（默认 8900，服务器模式使用）
PORT=8900

# 可选：思考强度（low / medium / high；客服场景建议 low，首字更快；留空 = 不发送该参数）
RAG_REASONING_EFFORT=low

# 可选：默认召回条数（默认 6）
RAG_TOP_K=6

# 可选：哈希向量维度（默认 8192；越小哈希碰撞越多，检索会变差）
RAG_EMBED_DIM=8192
