{
  "name": "rag-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RAG 客服可视化观测台：检索 / 融合 / Prompt 拼装 / 流式生成全链路可视化；支持 Node 服务器模式与浏览器内检索 + 同源转发真实大模型两种运行方式（零运行时依赖）",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node scripts/build-static.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "test": "node --test --test-timeout=30000 test/*.test.js",
    "eval": "node scripts/eval.js"
  }
}
